{
  "name": "cognitive-canvas-automation",
  "private": true,
  "description": "Playwright automation suite for Cognitive Canvas. Stands alone: it tests a copy of the app's build in app/ (npm run sync-app).",
  "type": "module",
  "scripts": {
    "setup": "playwright install chromium webkit firefox",
    "sync-app": "node scripts/sync-app.mjs",
    "smoke": "playwright test -c playwright.config.ts --project=chromium --grep @smoke",
    "sanity": "playwright test -c playwright.config.ts --project=chromium --project=phone --project=tablet --project=ipad --project=offline --grep @sanity",
    "p1": "playwright test -c playwright.config.ts --project=chromium --project=phone --project=tablet --project=ipad --project=offline --grep @P1",
    "regression": "playwright test -c playwright.config.ts --project=chromium --project=phone --project=tablet --project=ipad --project=offline",
    "performance": "playwright test -c playwright.config.ts --project=performance --workers=1",
    "a11y": "playwright test -c playwright.config.ts --project=chromium --grep @a11y",
    "cross-browser": "playwright test -c playwright.config.ts --project=firefox --project=webkit",
    "live": "playwright test -c playwright.config.ts --project=live --workers=1",
    "all": "playwright test -c playwright.config.ts",
    "ui": "playwright test -c playwright.config.ts --ui",
    "report": "playwright show-report reports/html",
    "typecheck": "tsc -p tsconfig.json",
    "inventory": "node scripts/build-inventory.mjs",
    "mobrowser:setup": "node scripts/mobrowser-setup.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.12.2",
    "fflate": "0.8.3",
    "typescript": "5.9.3"
  }
}
